---
import '../styles/global.css';
import HeroSection from '@/components/sections/HeroSection.astro';
import InviteSection from '@/components/sections/InviteSection.astro';
import LinksSection from '@/components/sections/LinksSection.astro';
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Giovanna XV</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caladea:wght@400;700&family=Great+Vibes&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="overflow-hidden bg-black">
		<main id="viewport" class="h-dvh overflow-hidden">
			<div id="track" class="transition-transform duration-700 ease-in-out will-change-transform">
				<HeroSection />
				<InviteSection />
				<LinksSection />
			</div>
		</main>

		<script>
			// Navigation is state-driven instead of scroll-driven: the active section
			// index moves the track by exact -100dvh steps via transform. Unlike a
			// pixel scroll position, the dvh transform re-resolves whenever the
			// viewport height changes (mobile URL bar, resize), so sections can never
			// drift and bleed into each other.
			const SECTION_IDS = ['hero', 'invite', 'links'];

			const viewport = document.getElementById('viewport');
			const track = document.getElementById('track');
			if (!viewport || !track) throw new Error('Section viewport markup is missing');

			const sections = SECTION_IDS.map((id) => {
				const section = document.getElementById(id);
				if (!section) throw new Error(`Section not found: #${id}`);
				return section;
			});

			let current = -1;

			function goTo(index: number, animate = true) {
				if (index < 0 || index >= sections.length || index === current) return;
				current = index;
				if (!animate) track!.style.transition = 'none';
				track!.style.transform = `translateY(${index * -100}dvh)`;
				if (!animate) {
					void track!.offsetHeight; // flush styles so the jump isn't animated
					track!.style.transition = '';
				}
				// Inactive sections are inert so Tab can't focus offscreen links
				// (focus would otherwise force a partial native scroll).
				sections.forEach((section, i) => section.toggleAttribute('inert', i !== index));
				history.replaceState(null, '', `#${SECTION_IDS[index]}`);
			}

			const initialIndex = SECTION_IDS.indexOf(location.hash.slice(1));
			goTo(initialIndex === -1 ? 0 : initialIndex, false);

			document.querySelectorAll('a[data-nav]').forEach((link) => {
				link.addEventListener('click', (event) => {
					event.preventDefault();
					const targetId = (link.getAttribute('href') ?? '').replace('#', '');
					const index = SECTION_IDS.indexOf(targetId);
					if (index === -1) {
						console.error(`Navigation target not found: #${targetId}`);
						return;
					}
					goTo(index);
				});
			});

			window.addEventListener('hashchange', () => {
				const index = SECTION_IDS.indexOf(location.hash.slice(1));
				if (index !== -1) goTo(index);
			});

			// Browsers can still natively scroll an overflow:hidden container
			// (find-in-page, some a11y tools); undo any stray scroll immediately.
			viewport.addEventListener('scroll', () => {
				viewport.scrollTop = 0;
				viewport.scrollLeft = 0;
			});
		</script>
	</body>
</html>
