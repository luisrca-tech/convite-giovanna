---
import '../styles/global.css';
import HeroSection from '@/components/sections/HeroSection.astro';
import InviteSection from '@/components/sections/InviteSection.astro';
import LinksSection from '@/components/sections/LinksSection.astro';

const siteTitle = 'Giovanna XV';
const siteDescription =
	'Você é nosso convidado para uma noite inesquecível! Convite digital dos 15 anos da Giovanna — sábado, 15 de agosto, às 20:30, no Espaço Green Place.';
const siteImage = '/images/giovanna/logo.png';
const favicon = siteImage;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={favicon} />
		<link rel="apple-touch-icon" href={favicon} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{siteTitle}</title>
		<meta name="description" content={siteDescription} />
		<meta name="theme-color" content="#7b0016" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:image" content={new URL(siteImage, Astro.url)} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={siteDescription} />
		<meta name="twitter:image" content={new URL(siteImage, Astro.url)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Caladea:wght@400;700&family=Great+Vibes&family=Playfair+Display:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="overflow-hidden bg-black">
		<main id="viewport" class="h-dvh overflow-hidden">
			<div id="track" class="transition-transform duration-700 ease-in-out will-change-transform">
				<HeroSection />
				<InviteSection />
				<LinksSection />
			</div>
		</main>

		<script>
			// Navigation is state-driven instead of scroll-driven: the active section
			// index moves the track by exact -100dvh steps via transform. Unlike a
			// pixel scroll position, the dvh transform re-resolves whenever the
			// viewport height changes (mobile URL bar, resize), so sections can never
			// drift and bleed into each other.
			const SECTION_IDS = ['hero', 'invite', 'links'];

			const viewport = document.getElementById('viewport');
			const track = document.getElementById('track');
			if (!viewport || !track) throw new Error('Section viewport markup is missing');

			const sections = SECTION_IDS.map((id) => {
				const section = document.getElementById(id);
				if (!section) throw new Error(`Section not found: #${id}`);
				return section;
			});

			let current = -1;

			function goTo(index: number, animate = true) {
				if (index < 0 || index >= sections.length || index === current) return;
				current = index;
				if (!animate) track!.style.transition = 'none';
				track!.style.transform = `translateY(${index * -100}dvh)`;
				if (!animate) {
					void track!.offsetHeight; // flush styles so the jump isn't animated
					track!.style.transition = '';
				}
				// Inactive sections are inert so Tab can't focus offscreen links
				// (focus would otherwise force a partial native scroll).
				sections.forEach((section, i) => section.toggleAttribute('inert', i !== index));
				history.replaceState(null, '', `#${SECTION_IDS[index]}`);
			}

			const initialIndex = SECTION_IDS.indexOf(location.hash.slice(1));
			goTo(initialIndex === -1 ? 0 : initialIndex, false);

			// Delegation on the document so links rendered later by React islands
			// (e.g. the invite footer arrow) still trigger navigation.
			document.addEventListener('click', (event) => {
				const link = (event.target as Element | null)?.closest('a[data-nav]');
				if (!link) return;
				event.preventDefault();
				const targetId = (link.getAttribute('href') ?? '').replace('#', '');
				const index = SECTION_IDS.indexOf(targetId);
				if (index === -1) {
					console.error(`Navigation target not found: #${targetId}`);
					return;
				}
				goTo(index);
			});

			window.addEventListener('hashchange', () => {
				const index = SECTION_IDS.indexOf(location.hash.slice(1));
				if (index !== -1) goTo(index);
			});

			// Browsers can still natively scroll an overflow:hidden container
			// (find-in-page, some a11y tools); undo any stray scroll immediately.
			viewport.addEventListener('scroll', () => {
				viewport.scrollTop = 0;
				viewport.scrollLeft = 0;
			});
		</script>
	</body>
</html>
