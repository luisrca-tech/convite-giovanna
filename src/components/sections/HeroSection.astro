---

---

<section
	id="hero"
	class="relative flex h-dvh w-full items-center justify-center overflow-hidden bg-black bg-[url('/images/giovanna/background-page-1.png')] bg-cover bg-center"
>
	<a
		href="#invite"
		data-nav
		aria-label="Clique aqui para abrir"
		class="flex flex-col items-center gap-[calc(24*var(--s))]"
	>
		<img
			src="/images/giovanna/logo.png"
			alt="Giovanna XV"
			class="w-[calc(540*var(--s))] rounded-full"
		/>
		<svg
			viewBox="-20 0 720 165"
			class="block w-[calc(680*var(--s))] overflow-visible drop-shadow-[0_0_10px_rgba(243,217,227,0.45)]"
			aria-hidden="true"
		>
			<path id="hero-open-arc" d="M -20 38 Q 340 148 700 38" fill="none"></path>
			<text
				class="font-[family-name:var(--font-juana)]"
				fill="#f3d9e3"
				font-size="52"
				letter-spacing="3"
				text-anchor="middle"
			>
				<textPath href="#hero-open-arc" startOffset="50%">Clique aqui para abrir</textPath>
			</text>
		</svg>
	</a>
</section>
