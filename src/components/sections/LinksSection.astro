---
import LinksContent from './LinksContent.tsx';
---

<section id="links" class="relative h-dvh w-full overflow-hidden bg-[#7b0016]">
	<img
		src="/images/giovanna/background-page-2.jpg"
		alt=""
		class="absolute inset-0 h-full w-full object-cover opacity-[0.28]"
	/>

	<img
		src="/images/giovanna/gliter.png"
		alt=""
		aria-hidden="true"
		class="pointer-events-none absolute top-[calc(60*var(--s))] left-[calc(-60*var(--s))] h-[calc(525*var(--s))] w-[111vw] max-w-none rotate-180 opacity-60"
	/>
	<img
		src="/images/giovanna/gliter.png"
		alt=""
		aria-hidden="true"
		class="pointer-events-none absolute bottom-[calc(-40*var(--s))] left-[calc(-60*var(--s))] h-[calc(525*var(--s))] w-[111vw] max-w-none -scale-x-100 opacity-50"
	/>

	<LinksContent client:load />
</section>
