---
const iconClass = 'h-[calc(110*var(--s))] w-[calc(110*var(--s))] text-[#f6e7d3]';
---

<section id="links" class="relative h-dvh w-full overflow-hidden bg-[#7b0016]">
	<img
		src="/images/giovanna/background-page-2.jpg"
		alt=""
		class="absolute inset-0 h-full w-full object-cover opacity-[0.28]"
	/>

	<div
		class="relative z-10 flex h-full flex-col justify-between px-[calc(70*var(--s))] py-[calc(110*var(--s))] font-[family-name:var(--font-caladea)] text-[calc(42*var(--s))] leading-snug text-[#f6e7d3]"
	>
		<div class="flex items-start justify-between">
			<a href="#" class="flex flex-col items-start gap-[calc(24*var(--s))]">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class={iconClass}
				>
					<circle cx="12" cy="12" r="10"></circle>
					<path d="m9 12 2 2 4-4"></path>
				</svg>
				<span>Confirme<br />sua presença</span>
			</a>

			<a href="#" class="flex flex-col items-end gap-[calc(24*var(--s))] text-right">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class={iconClass}
				>
					<path
						d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
					></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				<span>Localização</span>
			</a>
		</div>

		<img
			src="/images/giovanna/globo.png"
			alt="Globo de espelhos"
			class="mx-auto w-[calc(560*var(--s))]"
		/>

		<div class="flex items-end justify-between">
			<a href="#" class="flex flex-col items-start gap-[calc(24*var(--s))]">
				<span>Quer me dar um<br />mimo? Aqui estão<br />meus tamanhos</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class={iconClass}
				>
					<rect x="3" y="8" width="18" height="4" rx="1"></rect>
					<path d="M12 8v13"></path>
					<path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path>
					<path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"></path>
				</svg>
			</a>

			<a href="#" class="flex flex-col items-end gap-[calc(24*var(--s))] text-right">
				<span>Deixe um recado<br />para gigi</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class={iconClass}
				>
					<path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"></path>
					<path d="M2 6h4"></path>
					<path d="M2 10h4"></path>
					<path d="M2 14h4"></path>
					<path d="M2 18h4"></path>
					<path
						d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"
					></path>
				</svg>
			</a>
		</div>
	</div>
</section>
