---
---

<section id="invite" class="relative h-dvh w-full overflow-hidden bg-[#7b0016]">
	<img
		src="/images/giovanna/background-page-2.jpg"
		alt=""
		class="absolute inset-0 h-full w-full object-cover opacity-[0.28]"
	/>

	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute top-[8%] -left-[20%] w-[calc(900*var(--s))] opacity-60"
	/>
	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute top-[38%] -left-[30%] w-[calc(1000*var(--s))] -rotate-12 opacity-50"
	/>
	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute -right-[25%] bottom-[12%] w-[calc(900*var(--s))] rotate-180 opacity-50"
	/>

	<div class="relative z-10 flex h-full flex-col justify-between">
		<header class="relative pt-[calc(80*var(--s))]">
			<h2
				class="relative text-center font-[family-name:var(--font-caladea)] text-[calc(35*var(--s))] tracking-[0.18em] text-[#ffd9e8] uppercase"
			>
				Você é nosso convidado<br />para uma noite inesquecível!
			</h2>
		</header>

		<div class="relative flex flex-col items-center">
			<img
				src="/images/giovanna/arco.png"
				alt=""
				class="pointer-events-none absolute top-1/2 left-1/2 w-[calc(1000*var(--s))] max-w-none -translate-x-1/2 -translate-y-[54%]"
			/>
			<img
				src="/images/giovanna/arco.png"
				alt=""
				class="pointer-events-none absolute top-1/2 left-1/2 w-[calc(1060*var(--s))] max-w-none -translate-x-[48%] -translate-y-1/2 opacity-70"
			/>
			<img
				src="/images/giovanna/gliter.png"
				alt=""
				class="pointer-events-none absolute top-[20%] left-1/2 w-[calc(760*var(--s))] -translate-x-1/2 opacity-70"
			/>

			<h1
				class="relative font-[family-name:var(--font-great-vibes)] text-[calc(210*var(--s))] leading-none text-[#ff8fc8] drop-shadow-[0_0_18px_rgba(255,120,190,0.55)]"
			>
				Giovanna
			</h1>
			<p
				class="relative font-[family-name:var(--font-kelin)] text-[calc(130*var(--s))] leading-none text-[#ff8fc8] drop-shadow-[0_0_14px_rgba(255,120,190,0.5)]"
			>
				XV
			</p>
			<p
				class="relative mt-[calc(40*var(--s))] text-center font-[family-name:var(--font-caladea)] text-[calc(40*var(--s))] leading-relaxed tracking-[0.14em] text-[#f6e7d3] uppercase drop-shadow-[0_0_10px_rgba(255,205,225,0.5)]"
			>
				Meus 15 anos<br />E eu quero você lá!
			</p>
		</div>

		<footer
			class="relative pb-[calc(60*var(--s))] font-[family-name:var(--font-juana)] text-[#f3e3c8]"
		>
			<svg
				viewBox="0 0 700 160"
				class="relative mx-auto block w-[calc(700*var(--s))] overflow-visible drop-shadow-[0_0_12px_rgba(255,220,235,0.55)]"
				aria-hidden="true"
			>
				<path id="sabado-arc" d="M 40 140 Q 350 -10 660 140" fill="none"></path>
				<text
					class="font-[family-name:var(--font-juana)] uppercase"
					fill="#f6e7d3"
					font-size="100"
					letter-spacing="12"
					text-anchor="middle"
				>
					<textPath href="#sabado-arc" startOffset="50%">Sábado</textPath>
				</text>
			</svg>

			<div
				class="relative -mt-[calc(44*var(--s))] flex items-center justify-center gap-[calc(50*var(--s))]"
			>
				<span
					class="flex flex-col items-center gap-[calc(14*var(--s))] text-[calc(52*var(--s))] tracking-[0.14em] uppercase"
				>
					<span
						class="block h-[2px] w-[calc(310*var(--s))] bg-gradient-to-r from-transparent via-[#fff3df] to-transparent"
					></span>
					agosto
					<span
						class="block h-[2px] w-[calc(310*var(--s))] bg-gradient-to-r from-transparent via-[#fff3df] to-transparent"
					></span>
				</span>
				<span class="text-[calc(150*var(--s))] leading-none">15</span>
				<span
					class="flex flex-col items-center gap-[calc(14*var(--s))] text-[calc(52*var(--s))] tracking-[0.14em]"
				>
					<span
						class="block h-[2px] w-[calc(310*var(--s))] bg-gradient-to-r from-transparent via-[#fff3df] to-transparent"
					></span>
					20:30
					<span
						class="block h-[2px] w-[calc(310*var(--s))] bg-gradient-to-r from-transparent via-[#fff3df] to-transparent"
					></span>
				</span>
			</div>

			<p
				class="relative mt-[calc(28*var(--s))] text-center text-[calc(50*var(--s))] tracking-[0.2em] uppercase"
			>
				Espaço Green Place
			</p>

			<a
				href="#links"
				data-nav
				class="absolute right-[calc(30*var(--s))] bottom-0"
				aria-label="Ir para a próxima sessão"
			>
				<img
					src="/images/giovanna/arrow-right.png"
					alt=""
					class="w-[calc(110*var(--s))] rotate-90"
				/>
			</a>
		</footer>
	</div>
</section>
