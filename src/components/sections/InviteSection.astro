---
import InviteContent from "./InviteContent.tsx";
---

<section id="invite" class="relative h-dvh w-full overflow-hidden bg-[#7b0016]">
	<img
		src="/images/giovanna/background-page-2.jpg"
		alt=""
		class="absolute inset-0 h-full w-full object-cover opacity-[0.28]"
	/>

	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute -top-[8%] left-1/2 w-[calc(1200*var(--s))] max-w-none -translate-x-1/2 rotate-180 opacity-60"
	/>
	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute top-[24%] left-1/2 w-[calc(1500*var(--s))] max-w-none -translate-x-1/2 opacity-65"
	/>
	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute bottom-[2%] left-1/2 w-[calc(1200*var(--s))] max-w-none -translate-x-1/2 -scale-x-100 opacity-50"
	/>

	<InviteContent client:load />
</section>

<style is:global>
	.invite-arc-svg {
		width: 88.2vw;
		height: 90vw;
		overflow: visible;
	}

	.invite-arc-stroke {
		stroke: #fff5fa;
		stroke-width: 2.5;
		vector-effect: non-scaling-stroke;
	}

	.invite-arc-stroke--outer {
		opacity: 0.5;
	}

	.invite-arc-stroke--inner {
		opacity: 0.7;
	}

	/* Canva Neon @ intensity 65: pale core + layered #df0e6d bloom */
	.invite-giovanna-neon {
		--neon: #df0e6d;
		color: #fff5fa;
		text-shadow:
			0 0 calc(2 * var(--s)) #fff,
			0 0 calc(4 * var(--s)) rgba(255, 255, 255, 0.85),
			0 0 calc(6 * var(--s)) var(--neon),
			0 0 calc(10 * var(--s)) var(--neon),
			0 0 calc(16 * var(--s)) rgba(223, 14, 109, 0.78),
			0 0 calc(24 * var(--s)) rgba(223, 14, 109, 0.65),
			0 0 calc(34 * var(--s)) rgba(223, 14, 109, 0.48),
			0 0 calc(46 * var(--s)) rgba(223, 14, 109, 0.32),
			0 0 calc(60 * var(--s)) rgba(223, 14, 109, 0.2);
	}

	/* Canva Neon @ intensity 14: #ffdfd9 core + layered bloom (xv-neon structure scaled) */
	.invite-footer-neon {
		--neon: #ffdfd9;
		color: #ffdfd9;
		text-shadow:
			0 0 calc(1 * var(--s)) #fff,
			0 0 calc(1 * var(--s)) rgba(255, 255, 255, 0.85),
			0 0 calc(1 * var(--s)) var(--neon),
			0 0 calc(2 * var(--s)) var(--neon),
			0 0 calc(3 * var(--s)) rgba(255, 223, 217, 0.95),
			0 0 calc(5 * var(--s)) rgba(255, 223, 217, 0.88),
			0 0 calc(7 * var(--s)) rgba(255, 223, 217, 0.78),
			0 0 calc(9 * var(--s)) rgba(255, 223, 217, 0.62),
			0 0 calc(12 * var(--s)) rgba(255, 223, 217, 0.48),
			0 0 calc(14 * var(--s)) rgba(255, 223, 217, 0.35);
	}

	.invite-sabado-neon {
		fill: #ffdfd9;
	}

	/* Canva Neon @ intensity 90: pale core + layered #ff0074 bloom */
	.invite-xv-neon {
		--neon: #ff0074;
		color: #fff5fa;
		text-shadow:
			0 0 calc(2 * var(--s)) #fff,
			0 0 calc(5 * var(--s)) #fff,
			0 0 calc(8 * var(--s)) var(--neon),
			0 0 calc(14 * var(--s)) var(--neon),
			0 0 calc(22 * var(--s)) rgba(255, 0, 116, 0.95),
			0 0 calc(32 * var(--s)) rgba(255, 0, 116, 0.92),
			0 0 calc(44 * var(--s)) rgba(255, 0, 116, 0.88),
			0 0 calc(58 * var(--s)) rgba(255, 0, 116, 0.78),
			0 0 calc(74 * var(--s)) rgba(255, 0, 116, 0.62),
			0 0 calc(92 * var(--s)) rgba(255, 0, 116, 0.45);
	}
</style>
