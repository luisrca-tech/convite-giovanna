---

---

<section id="invite" class="relative h-dvh w-full overflow-hidden bg-[#7b0016]">
	<img
		src="/images/giovanna/background-page-2.jpg"
		alt=""
		class="absolute inset-0 h-full w-full object-cover opacity-[0.28]"
	/>

	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute top-[6%] -left-[18%] w-[calc(900*var(--s))] max-w-none -scale-x-100 opacity-60"
	/>
	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute top-[24%] left-1/2 w-[calc(1500*var(--s))] max-w-none -translate-x-1/2 opacity-65"
	/>
	<img
		src="/images/giovanna/gliter.png"
		alt=""
		class="absolute top-[65%] -left-[8%] w-[calc(1200*var(--s))] max-w-none rotate-180 opacity-50"
	/>

	<div class="relative z-10 flex h-full flex-col justify-between">
		<header class="relative pt-[calc(70*var(--s))]">
			<h2
				class="relative text-center font-[family-name:var(--font-caladea)] text-[calc(35*var(--s))] tracking-[0.18em] text-[#ff9cc6] uppercase drop-shadow-[0_0_8px_rgba(255,90,160,0.6)]"
			>
				Você é nosso convidado<br />para uma noite inesquecível!
			</h2>
		</header>

		<div class="relative flex flex-col items-center gap-[calc(56*var(--s))]">
			<!-- Two concentric rings as in the print: same center, outer ~9% larger,
			     both wider than tall (bright ring fills ~75.5% of arco.png). -->
			<img
				src="/images/giovanna/arco.png"
				alt=""
				class="pointer-events-none absolute top-[calc(50%-20*var(--s))] left-1/2 h-[calc(1062*var(--s))] w-[calc(1232*var(--s))] max-w-none -translate-x-1/2 -translate-y-1/2"
			/>
			<img
				src="/images/giovanna/arco.png"
				alt=""
				class="pointer-events-none absolute top-[calc(50%-20*var(--s))] left-1/2 h-[calc(1166*var(--s))] w-[calc(1331*var(--s))] max-w-none -translate-x-1/2 -translate-y-1/2 opacity-90"
			/>

			<h1
				class="invite-giovanna-neon relative font-[family-name:var(--font-great-vibes)] text-[calc(280*var(--s))] leading-none"
			>
				Giovanna
			</h1>
			<p
				class="invite-xv-neon relative font-[family-name:var(--font-kelin)] text-[calc(140*var(--s))] leading-none"
			>
				XV
			</p>
			<p
				class="relative text-center font-[family-name:var(--font-caladea)] text-[calc(52*var(--s))] leading-relaxed tracking-[0.14em] text-[#ff9cc6] uppercase drop-shadow-[0_0_10px_rgba(255,90,160,0.55)]"
			>
				Meus 15 anos<br />E eu quero você lá!
			</p>
		</div>

		<footer
			class="relative pb-[calc(189*var(--s))] font-[family-name:var(--font-juana)] text-[#ffe3de]"
		>
			<svg
				viewBox="0 0 700 160"
				class="relative mx-auto block w-[calc(700*var(--s))] overflow-visible drop-shadow-[0_0_12px_rgba(255,220,235,0.55)]"
				aria-hidden="true"
			>
				<path id="sabado-arc" d="M 40 140 Q 350 -10 660 140" fill="none"
				></path>
				<text
					class="font-[family-name:var(--font-juana)] uppercase"
					fill="#ffe3de"
					font-size="100"
					letter-spacing="12"
					text-anchor="middle"
				>
					<textPath href="#sabado-arc" startOffset="50%"
						>Sábado</textPath
					>
				</text>
			</svg>

			<div
				class="relative -mt-[calc(16*var(--s))] flex items-center justify-center gap-[calc(180*var(--s))]"
			>
				<span
					class="flex flex-col items-center gap-[calc(14*var(--s))] text-[calc(52*var(--s))] tracking-[0.14em] uppercase"
				>
					<span
						class="block h-[2px] w-[calc(250*var(--s))] bg-gradient-to-r from-transparent via-[#ffe3de] to-transparent"
					></span>
					agosto
					<span
						class="block h-[2px] w-[calc(250*var(--s))] bg-gradient-to-r from-transparent via-[#ffe3de] to-transparent"
					></span>
				</span>
				<span class="text-[calc(120*var(--s))] leading-none">15</span>
				<span
					class="flex flex-col items-center gap-[calc(14*var(--s))] text-[calc(52*var(--s))] tracking-[0.14em]"
				>
					<span
						class="block h-[2px] w-[calc(250*var(--s))] bg-gradient-to-r from-transparent via-[#ffe3de] to-transparent"
					></span>
					20:30
					<span
						class="block h-[2px] w-[calc(250*var(--s))] bg-gradient-to-r from-transparent via-[#ffe3de] to-transparent"
					></span>
				</span>
			</div>

			<p
				class="relative mt-[calc(41*var(--s))] text-center text-[calc(50*var(--s))] tracking-[0.2em] uppercase"
			>
				Espaço Green Place
			</p>

			<a
				href="#links"
				data-nav
				class="absolute right-[calc(30*var(--s))] bottom-0"
				aria-label="Ir para a próxima sessão"
			>
				<img
					src="/images/giovanna/arrow-right.png"
					alt=""
					class="w-[calc(110*var(--s))] rotate-90"
				/>
			</a>
		</footer>
	</div>
</section>

<style>
	/* Canva Neon @ intensity 65: pale core + layered #df0e6d bloom */
	.invite-giovanna-neon {
		--neon: #df0e6d;
		color: #fff5fa;
		text-shadow:
			0 0 calc(2 * var(--s)) #fff,
			0 0 calc(4 * var(--s)) rgba(255, 255, 255, 0.85),
			0 0 calc(6 * var(--s)) var(--neon),
			0 0 calc(10 * var(--s)) var(--neon),
			0 0 calc(16 * var(--s)) rgba(223, 14, 109, 0.78),
			0 0 calc(24 * var(--s)) rgba(223, 14, 109, 0.65),
			0 0 calc(34 * var(--s)) rgba(223, 14, 109, 0.48),
			0 0 calc(46 * var(--s)) rgba(223, 14, 109, 0.32),
			0 0 calc(60 * var(--s)) rgba(223, 14, 109, 0.2);
	}

	/* Canva Neon @ intensity 90: pale core + layered #ff0074 bloom */
	.invite-xv-neon {
		--neon: #ff0074;
		color: #fff5fa;
		text-shadow:
			0 0 calc(2 * var(--s)) #fff,
			0 0 calc(5 * var(--s)) #fff,
			0 0 calc(8 * var(--s)) var(--neon),
			0 0 calc(14 * var(--s)) var(--neon),
			0 0 calc(22 * var(--s)) rgba(255, 0, 116, 0.95),
			0 0 calc(32 * var(--s)) rgba(255, 0, 116, 0.92),
			0 0 calc(44 * var(--s)) rgba(255, 0, 116, 0.88),
			0 0 calc(58 * var(--s)) rgba(255, 0, 116, 0.78),
			0 0 calc(74 * var(--s)) rgba(255, 0, 116, 0.62),
			0 0 calc(92 * var(--s)) rgba(255, 0, 116, 0.45);
	}
</style>
